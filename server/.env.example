# JARVIS Configuration

# Server Settings
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000

# Gemini API Key (Optional for local fallback, required for multimodal vision & advanced function calling)
GEMINI_API_KEY=

# AI Model Selection
JARVIS_LIVE_MODEL=gemini-3.1-flash-live-preview
JARVIS_TEXT_MODEL=gemini-2.5-flash

# Voice Customization (Edge-TTS voices: en-GB-RyanNeural, en-US-GuyNeural, en-GB-SoniaNeural, etc.)
JARVIS_TTS_VOICE=en-GB-RyanNeural
JARVIS_TTS_RATE=+5%
JARVIS_TTS_PITCH=+0Hz

# Security Guardrails (strict | normal | relaxed)
GUARDRAIL_STRICTNESS=strict
AUTO_APPROVE_TIER2=true
